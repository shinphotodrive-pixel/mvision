                    </div>
                    <div class="chart-container">
                        <canvas id="chartInterfaceBandwidth"></canvas>
                    </div>
                </div>
            </div>

            <!-- Interface & Lens Mount Details Table -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-4 border-b border-slate-200 bg-slate-50 flex justify-between items-center">
                    <h3 class="font-bold text-slate-900 text-sm">인터페이스 표준 및 렌즈 마운트 비교 총괄</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="bg-slate-100 text-slate-700 uppercase font-semibold">
