                <!-- Filled dynamically by JS -->
            </div>
        </section>

        <!-- SECTION 3: HARDWARE & SENSORS -->
        <section id="sec-hardware" class="space-y-6 hidden">
            <!-- Section Intro -->
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                <h2 class="text-xl font-bold text-slate-900 mb-2">3. 핵심 하드웨어 생태계 & 광학 기술</h2>
                <p class="text-sm text-slate-600 leading-relaxed">
                    초고속 생산 라인 및 감시 체계의 원시 데이터 품질을 결정짓는 <strong>Sony Pregius S 4세대 BSI 글로벌 셔터</strong> 기술과 대표적인 <strong>데이터 전송 인터페이스(GigE, USB3, CXP-12)</strong> 및 렌즈 마운트 규격을 비교합니다.
                </p>
            </div>

            <!-- Sensor Tech Comparison Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Sensor Evolution Specs Card -->
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="font-bold text-slate-900 text-base">Sony Pregius S (4세대 BSI) vs 2세대 (FSI)</h3>
