                            <div class="truncate"><strong>주력 제품:</strong> ${v.products}</div>
                        </div>
                    </div>
                    <div class="pt-2 border-t border-slate-100 flex justify-between items-center text-xs">
                        <button onclick="openModal('${v.id}')" class="text-amber-600 font-bold hover:underline">상세보기 & 기술 스펙 ›</button>
                        <div class="flex space-x-2 text-slate-400">
                            <a href="${v.website}" target="_blank" title="공식 웹사이트" class="hover:text-amber-600">🌐</a>
                            <a href="${v.youtube}" target="_blank" title="공식 유튜브" class="hover:text-rose-600">📺</a>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterVendors(domain) {
            document.querySelectorAll('.v-filter-btn').forEach(btn => {
                if (btn.dataset.domain === domain) {
                    btn.className = 'v-filter-btn px-3 py-1.5 rounded-lg bg-amber-500 text-white font-medium';
                } else {
                    btn.className = 'v-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 font-medium';
                }
            });

            if (domain === 'all') {
                renderVendors(vendorsData);
            } else {
                renderVendors(vendorsData.filter(v => v.domain === domain));
            }
        }

        function searchVendors() {
            const query = document.getElementById('vendorSearch').value.toLowerCase();
            const filtered = vendorsData.filter(v => 
                v.name.toLowerCase().includes(query) ||
                v.country.toLowerCase().includes(query) ||
                v.products.toLowerCase().includes(query) ||
                v.chip.toLowerCase().includes(query)
            );
            renderVendors(filtered);
        }

        // VENDOR MODAL
        function openModal(id) {
            const v = vendorsData.find(item => item.id === id);
            if (!v) return;

            const content = document.getElementById('modalContent');
            content.innerHTML = `
                <div class="space-y-4">
                    <div class="border-b border-slate-200 pb-3">
                        <span class="text-xs bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded">${v.country} | ${v.domainLabel}</span>
                        <h2 class="text-xl font-bold text-slate-900 mt-1">${v.name}</h2>
                    </div>
                    
                    <p class="text-xs text-slate-600 leading-relaxed">${v.summary}</p>

                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs space-y-2 font-mono">
                        <div><strong class="text-slate-800">자체 개발 SoC / 핵심 AI:</strong> ${v.chip}</div>
                        <div><strong class="text-slate-800">주요 라인업:</strong> ${v.products}</div>
                        <div><strong class="text-slate-800">NDAA 상태:</strong> ${v.ndaa === 'compliant' ? '미국 국방수권법 준수 (서방 인프라 적합)' : 'NDAA 제재 대상'}</div>
                    </div>

                    <div class="pt-2 flex justify-end space-x-3 text-xs">
                        <a href="${v.website}" target="_blank" class="px-3 py-2 bg-slate-800 text-white rounded-lg hover:bg-slate-700 font-medium flex items-center space-x-1">
                            <span>🌐 공식 웹사이트 방문</span>
                        </a>
                        <a href="${v.youtube}" target="_blank" class="px-3 py-2 bg-rose-600 text-white rounded-lg hover:bg-rose-500 font-medium flex items-center space-x-1">
                            <span>📺 유튜브 채널</span>
                        </a>
                    </div>
                </div>
            `;

            const modal = document.getElementById('vendorModal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeModal() {
            const modal = document.getElementById('vendorModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        // TRIGGER SIMULATOR LOGIC
        function updateSim() {
            const speedKm = parseFloat(document.getElementById('inputSpeed').value);
            const latencyMs = parseFloat(document.getElementById('inputLatency').value);

            document.getElementById('valSpeed').innerText = `${speedKm} km/h`;
            document.getElementById('valLatency').innerText = `${latencyMs} ms`;

            // Physics math
            const speedMps = speedKm / 3.6;
            const distMeters = speedMps * (latencyMs / 1000);

            document.getElementById('resMps').innerText = `${speedMps.toFixed(2)} m/s`;
            document.getElementById('resDist').innerText = `${distMeters.toFixed(2)} m (${(distMeters * 100).toFixed(1)} cm)`;

            // Advice update
            const adviceEl = document.getElementById('simAdvice');
            const statusEl = document.getElementById('captureStatus');

            if (distMeters < 0.2) {
                statusEl.className = 'text-xs px-2.5 py-0.5 rounded font-bold bg-emerald-100 text-emerald-800';
                statusEl.innerText = '초정밀 포착 (머신비전 급)';
                adviceEl.innerText = `지연에 따른 위치 이동이 ${ (distMeters * 100).toFixed(1) }cm에 불과하여, 고속 컨베이어나 초고속 차번 인식에서도 피사체의 중앙 정밀 캡처가 가능합니다.`;
            } else if (distMeters < 2.0) {
                statusEl.className = 'text-xs px-2.5 py-0.5 rounded font-bold bg-amber-100 text-amber-800';
                statusEl.innerText = '보통 이동 (ITS 전용 IP 급)';
                adviceEl.innerText = `지연에 의해 차량이 약 ${ distMeters.toFixed(2) }m 밀려서 찍힙니다. 카메라 셔터 앵글 및 ROI 감지 구역을 전방으로 약 1.5~2m 여유 있게 설정해야 합니다.`;
            } else {
                statusEl.className = 'text-xs px-2.5 py-0.5 rounded font-bold bg-rose-100 text-rose-800';
                statusEl.innerText = '이탈 위험 (일반 감시 IP 급)';
                adviceEl.innerText = `지연으로 인해 대상이 ${ distMeters.toFixed(2) }m나 이탈하여, 앵글에서 사라지거나 모션 블러가 심해집니다. 외부 유선 트리거 결선 또는 글로벌 셔터 도입이 필수적입니다.`;
            }

            drawCanvasSim(distMeters);
        }

        function applyPresetCam(val) {
            if (val === 'mv') {
                document.getElementById('inputLatency').value = 1;
            } else if (val === 'its') {
                document.getElementById('inputLatency').value = 50;
            } else if (val === 'surv') {
                document.getElementById('inputLatency').value = 200;
            }
            updateSim();
        }

        function drawCanvasSim(distMeters) {
            const canvas = document.getElementById('simCanvas');
            const ctx = canvas.getContext('2d');
            
            // Handle canvas high-DPI scaling
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width;
            canvas.height = rect.height;

            const w = canvas.width;
            const h = canvas.height;

            // Background
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(0, 0, w, h);

            // Draw Road Lanes
            ctx.strokeStyle = '#334155';
            ctx.setLineDash([10, 10]);
            ctx.beginPath();
            ctx.moveTo(0, h / 2);
            ctx.lineTo(w, h / 2);
            ctx.stroke();
            ctx.setLineDash([]);

            // Trigger Line (Target Center)
            const targetX = w * 0.35;
            ctx.strokeStyle = '#10b981';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(targetX, 10);
            ctx.lineTo(targetX, h - 10);
            ctx.stroke();

            ctx.fillStyle = '#10b981';
            ctx.font = '10px sans-serif';
            ctx.fillText('트리거 센서 감지점 (0m)', targetX - 50, 20);

            // Calculate actual captured offset position (1m = 40px scale)
            const pixelOffset = distMeters * 40;
            const capturedX = Math.min(targetX + pixelOffset, w - 60);

            // Actual Capture Line
            ctx.strokeStyle = pixelOffset > 80 ? '#f43f5e' : '#f59e0b';
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(capturedX, 10);
            ctx.lineTo(capturedX, h - 10);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = pixelOffset > 80 ? '#f43f5e' : '#f59e0b';
            ctx.fillText(`실제 셔터 포착점 (+${distMeters.toFixed(2)}m)`, capturedX + 5, h - 15);

            // Draw Vehicle Box
            ctx.fillStyle = '#38bdf8';
            ctx.fillRect(capturedX - 25, h / 2 - 15, 50, 30);
            ctx.fillStyle = '#0284c7';
            ctx.fillRect(capturedX + 5, h / 2 - 12, 15, 24); // Windshield

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 9px sans-serif';
            ctx.fillText('CAR', capturedX - 15, h / 2 + 3);
        }

        // CHART.JS INITIALIZATIONS
        function initOverviewCharts() {
            // Chart 1: Technical Convergence
            const ctx1 = document.getElementById('chartConvergence').getContext('2d');
            new Chart(ctx1, {
                type: 'radar',
                data: {
                    labels: ['초고속 프레임', '무손실 데이터 전송', '온디바이스 NPU AI', '장거리 네트워크', '사이버 보안 & NDAA', '저조도 WDR'],
                    datasets: [
                        {
                            label: '머신비전 카메라',
                            data: [95, 95, 75, 40, 60, 50],
                            borderColor: '#d97706',
                            backgroundColor: 'rgba(217, 119, 6, 0.2)',
                            borderWidth: 2
                        },
                        {
                            label: '물리 보안 AI 카메라',
                            data: [40, 50, 90, 95, 95, 90],
                            borderColor: '#0d9488',
                            backgroundColor: 'rgba(13, 148, 136, 0.2)',
                            borderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            min: 0,
                            max: 100,
                            ticks: { display: false }
                        }
                    },
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });
        }

        function initHardwareCharts() {
            window.chartsInitialized = true;

            // Chart 2: Pregius S vs 2nd Gen
            const ctx2 = document.getElementById('chartSensorComp').getContext('2d');
            new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: ['픽셀 피치 (µm, 낮을수록 우수)', '양자 효율 QE (%)', '동일 크기 센서 해상도 배율', '최대 프레임 레이트 스케일'],
                    datasets: [
                        {
                            label: '2세대 FSI 글로벌 셔터',
                            data: [3.45, 60, 1.0, 1.0],
                            backgroundColor: '#94a3b8'
                        },
                        {
                            label: '4세대 Pregius S (BSI)',
                            data: [2.74, 71.5, 2.1, 2.4],
                            backgroundColor: '#d97706'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true }
                    },
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    }
                }
            });

            // Chart 3: Interface Bandwidth
            const ctx3 = document.getElementById('chartInterfaceBandwidth').getContext('2d');
            new Chart(ctx3, {
                type: 'bar',
                data: {
                    labels: ['GigE Standard', '5GigE', 'USB3 Vision', '10GigE', 'CXP-12 (4채널)'],
                    datasets: [{
                        label: '최대 대역폭 (Gbps)',
                        data: [1, 5, 5, 10, 50],
                        backgroundColor: [
                            '#cbd5e1',
                            '#94a3b8',
                            '#38bdf8',
                            '#0d9488',
                            '#d97706'
                        ]
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { beginAtZero: true, title: { display: true, text: 'Gbps' } }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        // INIT ON LOAD
        window.addEventListener('DOMContentLoaded', () => {
            renderVendors(vendorsData);
            initOverviewCharts();

            // Handle window resize for simulator canvas
            window.addEventListener('resize', () => {
                if (!document.getElementById('sec-simulator').classList.contains('hidden')) {
                    updateSim();
                }
            });
        });
    </script>
