                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm border-l-4 border-l-rose-500">
                    <span class="text-xs font-semibold text-slate-500 uppercase">규제 준수 비율 (NDAA)</span>
                    <p class="text-2xl font-black text-slate-900 mt-1">78.5 %</p>
                    <p class="text-xs text-slate-500 mt-1">서방국 주요 기업 완벽 대응</p>
                </div>
            </div>

            <!-- Visual Charts Row -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Visual 1: Technical Focus Comparison -->
