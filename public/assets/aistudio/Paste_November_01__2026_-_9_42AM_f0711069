<body class="bg-slatebg text-slate-800 font-sans antialiased min-h-screen flex flex-col">

<!-- Chosen Palette: Warm Amber Minimalist Light (Background: #f8fafc, Card: #ffffff, Primary: #0f172a, Accent: #d97706 & #0d9488) -->

<!-- Application Structure Plan:
     1. Executive Header & Global Metrics Summary: Highlights key Industry Convergence trends, NDAA/EU AI Act compliance ratios, and top manufacturers.
     2. Tabbed Navigation Menu:
        - [전체 개요 & 융합 트렌드] (Overview & Technical Convergence)
        - [글로벌 제조사 탐색기] (Vendor Explorer & Filter Matrix)
        - [하드웨어 & 센서 에코시스템] (Sensor & Interface Technical Specs)
        - [실시간 트리거/속도 변위 계산기] (Trigger Latency Physics Simulator)
        - [규제 & 지정학 리스크] (NDAA & EU AI Act Compliance Matrix)
     3. Interactive Vendor Detail Modal: Displays granular SoC specs (ARTPEC-9, Wisenet 9, Pregius S), official websites, YouTube channels, and key strengths.
     4. Rationale: Light mode UI with high clarity enables engineers, investors, and system architects to easily compare complex hardware specs and regulatory impacts.
-->

<!-- Visualization & Content Choices:
     1. Interface Bandwidth vs Distance -> Grouped Bar Chart (Chart.js) -> Compares GigE, USB3, CXP-12 -> Explains interface selection logic.
     2. Pregius S vs Legacy FSI Sensors -> Radar/Bar Chart (Chart.js) -> Highlights Pixel Pitch, QE, Frame Rate improvements.
     3. Vendor Capabilities Matrix -> Filterable HTML Grid & Interactive Cards -> Real-time search by Region, Domain, NDAA status.
     4. Dynamic Trigger Latency Calculator -> Interactive HTML Form + Canvas rendering -> Computes exact distance offset at high speed.
     5. Regulatory Timeline & Impact Grid -> Styled HTML Cards with status badges -> Clear presentation of EU AI Act and NDAA constraints.
-->

<!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->

    <!-- Top Navigation Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <span class="p-2 bg-amber-500 text-white rounded-lg text-xl font-bold">📷</span>
                    <div>
                        <h1 class="text-lg font-bold text-slate-900 leading-tight">글로벌 머신비전 & 보안 카메라 산업 분석</h1>
                        <p class="text-xs text-slate-500">지능형 엣지 AI, 고속 센서 기술 및 글로벌 규제 동향</p>
                    </div>
                </div>
                <div class="hidden md:flex items-center space-x-4 text-xs font-medium">
                    <span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-full border border-amber-200">
                        ⚡ 융합 패러다임: 엣지 AI & Global Shutter
                    </span>
                    <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-full border border-emerald-200">
                        🛡️ NDAA & EU AI Act 대응
                    </span>
                </div>
            </div>
            
            <!-- Navigation Tabs -->
            <nav class="flex space-x-6 overflow-x-auto text-sm border-t border-slate-100 pt-1">
                <button onclick="switchTab('overview')" id="tab-btn-overview" class="tab-btn active py-2.5 px-1 font-medium text-slate-600 hover:text-amber-600 whitespace-nowrap">
                    📊 종합 개요 & 트렌드
                </button>
                <button onclick="switchTab('vendors')" id="tab-btn-vendors" class="tab-btn py-2.5 px-1 font-medium text-slate-600 hover:text-amber-600 whitespace-nowrap">
